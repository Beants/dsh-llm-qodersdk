{
  "name": "@deepseek-ai/dsh-llm-qoder",
  "description": "Qoder CLI (qoder-agent-sdk) adapter for the DeepSeek Harness LLM seam",
  "version": "0.1.5",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "src/**/*.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JiamingZang/dsh-llm-qodersdk.git"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@qoder-ai/qoder-agent-sdk": "^1.0.21",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
